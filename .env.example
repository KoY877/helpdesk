# Copy this file to ".env" and fill in the values.
# docker-compose reads these variables automatically.

# --- PostgreSQL / backend datasource ---
# Used by the postgres service and injected into the backend.
DB_USERNAME=helpdesk_admin
DB_PASSWORD=change-me

# --- JWT ---
# Base64-encoded secret used to sign tokens (use a long, random value).
JWT_SECRET=change-me-with-a-long-random-base64-secret
# Access-token lifetime in milliseconds (default 3600000 = 1h).
JWT_ACCESS_EXPIRATION=3600000
